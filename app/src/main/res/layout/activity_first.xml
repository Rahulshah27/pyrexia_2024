<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/backgroundColor"
        tools:context=".FirstActivity">

        <!-- App Title -->
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="@color/primaryTextColor"
            android:gravity="center"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="40dp"/>

        <!-- Subtitle -->
        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/welcome_text"
            android:textSize="@dimen/_12ssp"
            android:textColor="@color/secondaryTextColor"
            android:gravity="center"
            app:layout_constraintTop_toBottomOf="@id/tvTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="10dp"/>

        <!-- QR Icon -->
        <ImageView
            android:id="@+id/ivQrIcon"
            android:layout_width="@dimen/_100sdp"
            android:layout_height="@dimen/_100sdp"
            android:src="@drawable/ic_qr_code"
            android:contentDescription="@string/scan_qr_code"
            app:tint="@color/primaryColor"
            app:layout_constraintTop_toBottomOf="@id/tvSubtitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="50dp"/>

        <!-- Generate Single QR Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_generateSingleQr"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/generate_single_qr"
            android:textStyle="bold"
            app:cornerRadius="@dimen/_14sdp"
            app:icon="@drawable/ic_qr_code"
            app:iconGravity="textStart"
            app:iconPadding="@dimen/_6sdp"
            app:backgroundTint="@color/primaryColor"
            android:textColor="@android:color/white"
            app:layout_constraintTop_toBottomOf="@id/ivQrIcon"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="@dimen/_24sdp"
            android:layout_marginHorizontal="30dp"/>

        <!-- Generate Bulk QR Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_generateBulkQr"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/generate_bulk_qr"
            android:textStyle="bold"
            app:cornerRadius="@dimen/_14sdp"
            app:icon="@drawable/ic_new_qr_in_bulk"
            app:iconGravity="textStart"
            app:iconPadding="@dimen/_6sdp"
            app:backgroundTint="@color/secondaryColor"
            android:textColor="@android:color/white"
            app:layout_constraintTop_toBottomOf="@id/btn_generateSingleQr"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="16dp"
            android:layout_marginHorizontal="30dp"/>

        <!-- Scan Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/firstActivityScanButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/scan_qr_code"
            android:textStyle="bold"
            app:cornerRadius="@dimen/_14sdp"
            app:icon="@drawable/ic_camera"
            app:iconGravity="textStart"
            app:iconPadding="@dimen/_6sdp"
            app:backgroundTint="@color/primaryColor"
            android:textColor="@android:color/white"
            app:layout_constraintTop_toBottomOf="@id/btn_generateBulkQr"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="20dp"
            android:layout_marginHorizontal="30dp"/>

        <!-- Go to Admin Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_goToAdmin"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/go_to_admin"
            android:textStyle="bold"
            app:cornerRadius="16dp"
            app:icon="@drawable/ic_admin"
            app:iconGravity="textStart"
            app:iconPadding="8dp"
            app:backgroundTint="@color/secondaryColor"
            android:textColor="@android:color/white"
            app:layout_constraintTop_toBottomOf="@id/firstActivityScanButton"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="16dp"
            android:layout_marginHorizontal="30dp"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
